# Resonance environment — copy to .env.local and fill in real values.
# Never commit .env.local.

# Supabase project URL (public, used by browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only — bypasses RLS, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — journey scaffolding + Studio analysis summaries
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI API key — poetry text-to-speech
OPENAI_API_KEY=sk-your-key

# fal.ai key — AI image generation per journey phase
FAL_KEY=your-fal-key

# Absolute path to ffmpeg binary — server-side audio transcode (ALAC → AAC)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Admin email — gates admin-only routes/tools (server-only, not NEXT_PUBLIC_)
ADMIN_EMAIL=you@example.com

# Optional: Vercel KV for durable rate limiting (falls back to in-memory if unset)
# KV_REST_API_URL=https://your-kv.upstash.io
# KV_REST_API_TOKEN=your-kv-token
